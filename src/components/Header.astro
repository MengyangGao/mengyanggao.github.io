---
import { getHomeContent, getSiteContent } from '../lib/site-content';
import LocalizedTextView from './LocalizedText.astro';

interface Props {
  active?: string;
}

const { active = 'home' } = Astro.props;
const siteContent = getSiteContent();
const homeContent = getHomeContent();
const { profile, siteName } = siteContent;
const brand = {
  en: profile.name.en ? `${profile.name.en}'s Page` : siteName || 'Personal Site',
  zhHans: profile.name.zhHans ? `${profile.name.zhHans}的主页` : siteName || '个人主页',
  zhHant: profile.name.zhHant ? `${profile.name.zhHant}的主頁` : siteName || '個人主頁',
};
const menuLabel = { en: 'Menu', zhHans: '菜单', zhHant: '選單' };
const links = homeContent.navigation;
---

<header class="topbar">
  <div class="topbar-inner">
    <button
      type="button"
      class="menu-toggle"
      data-toggle-menu
      aria-expanded="false"
      aria-controls="mobile-drawer"
      aria-label="Open navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a class="brand" href="/">
        <span class="brand-text">
          <LocalizedTextView text={brand} />
        </span>
    </a>

    <nav class="nav nav-desktop" aria-label="Main navigation">
      {
        links.map((item) => (
          <a class:list={{ 'nav-link': true, active: active === item.key }} href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
            <LocalizedTextView text={item.labels} />
          </a>
        ))
      }
    </nav>

    <div class="topbar-actions">
      <a class="rss-link" href="/rss.xml" target="_blank" rel="noopener noreferrer">
        <img src="/assets/images/social/rss.svg" alt="" aria-hidden="true" />
        <span>RSS</span>
      </a>
      <button type="button" class="switch-compact switch-theme" data-toggle-theme aria-label="Theme">
        <span data-theme-value="light" title="Light mode">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2.5v2"></path>
            <path d="M12 19.5v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2.5 12h2"></path>
            <path d="M19.5 12h2"></path>
            <path d="m4.93 19.07 1.41-1.41"></path>
            <path d="m17.66 6.34 1.41-1.41"></path>
          </svg>
        </span>
        <span class="switch-sep" aria-hidden="true">/</span>
        <span data-theme-value="dark" title="Dark mode">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
      </button>
      <button type="button" class="switch-compact" data-toggle-lang>
        <span data-lang-value="en">EN</span>
        <span class="switch-sep">/</span>
        <span data-lang-value="zh-Hans">简</span>
        <span class="switch-sep">/</span>
        <span data-lang-value="zh-Hant">繁</span>
      </button>
    </div>
  </div>

  <aside id="mobile-drawer" class="mobile-drawer" aria-hidden="true" inert>
    <div class="mobile-drawer-head">
      <span class="mobile-drawer-title">
        <LocalizedTextView text={menuLabel} />
      </span>
      <button type="button" class="mobile-drawer-close" data-close-menu aria-label="Close navigation menu">×</button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {
        links.map((item) => (
          <a class:list={{ 'mobile-nav-link': true, active: active === item.key }} href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
            <LocalizedTextView text={item.labels} />
          </a>
        ))
      }
    </nav>
  </aside>
  <button type="button" class="mobile-drawer-backdrop" data-menu-backdrop aria-label="Close menu"></button>
</header>

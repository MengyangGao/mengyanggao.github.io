---
import type { CardStat } from '../lib/page-helpers';

interface Props {
  icon: NonNullable<CardStat['icon']>;
}

const { icon } = Astro.props;
---

<span class:list={['media-stat-icon', `media-stat-icon-${icon}`]}>
  {icon === 'star' && (
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path fill="currentColor" d="M8 .25 10.09 5h4.91l-3.8 3.04 1.45 4.71L8 9.89l-4.65 2.86 1.45-4.71L1 5h4.91L8 .25Z"></path>
    </svg>
  )}
  {icon === 'fork' && (
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path fill="currentColor" d="M5 2.5a2.5 2.5 0 1 0-1 2V6A3 3 0 0 0 7 9h1v2.5a2.5 2.5 0 1 0 1 0V9h1a3 3 0 0 0 3-3V4.5a2.5 2.5 0 1 0-1 0V6a2 2 0 0 1-2 2H9V4.5a2.5 2.5 0 1 0-1 0V8H7a2 2 0 0 1-2-2V4.5a2.5 2.5 0 0 0 0-2Z"></path>
    </svg>
  )}
  {icon === 'view' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M12 5c5.5 0 9.8 3.8 11 6.9.1.3.1.9 0 1.2C21.8 16.2 17.5 20 12 20s-9.8-3.8-11-6.9a1.5 1.5 0 0 1 0-1.2C2.2 8.8 6.5 5 12 5Zm0 2C7.8 7 4.3 9.8 3.1 12c1.2 2.2 4.7 5 8.9 5s7.7-2.8 8.9-5c-1.2-2.2-4.7-5-8.9-5Zm0 2.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z"></path>
    </svg>
  )}
  {icon === 'like' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M2.25 10.5A.75.75 0 0 1 3 9.75h2.25v10.5H3a.75.75 0 0 1-.75-.75V10.5Zm4.5 9.17V9.64l4.13-5.53A1.5 1.5 0 0 1 13.57 5.4l-.82 4.35h5.8a2.25 2.25 0 0 1 2.21 2.67l-1.15 6a2.25 2.25 0 0 1-2.2 1.83H6.75Z"></path>
    </svg>
  )}
  {icon === 'calendar' && (
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path fill="currentColor" d="M4.75 1a.75.75 0 0 1 .75.75V2h5V1.75a.75.75 0 0 1 1.5 0V2h.5A2.5 2.5 0 0 1 15 4.5v8A2.5 2.5 0 0 1 12.5 15h-9A2.5 2.5 0 0 1 1 12.5v-8A2.5 2.5 0 0 1 3.5 2H4v-.25A.75.75 0 0 1 4.75 1ZM2.5 6v6.5c0 .55.45 1 1 1h9c.55 0 1-.45 1-1V6h-11Z"></path>
    </svg>
  )}
</span>

---
import '../styles/global.css';
import LocalizedTextView from '../components/LocalizedText.astro';
import { getSameAsLinks, getSiteContent, resolveContentAssetPath } from '../lib/site-content';
import { resolveSite } from '../lib/site-url';

type JsonLd = Record<string, unknown>;

interface Props {
  title: string;
  description?: string;
  jsonLd?: JsonLd | JsonLd[];
  noIndex?: boolean;
  image?: string;
  pageType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  initialLang?: 'en' | 'zh-Hans' | 'zh-Hant';
}

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || '';
const plausibleScript = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT || 'https://plausible.io/js/script.js';
const umamiScript = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || '';
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || '';
const siteContent = getSiteContent();
const { profile, siteName, seo, footer } = siteContent;
const footerOwner = profile.name.en || siteName || 'Mengyang Gao';

const {
  title,
  description = seo.defaultDescription,
  jsonLd = [],
  noIndex = false,
  image = '',
  pageType = 'website',
  publishedTime = '',
  modifiedTime = '',
  tags = [],
  author = profile.name.en || profile.name.zhHans || profile.name.zhHant,
  initialLang = 'en',
} = Astro.props;
const documentLang = initialLang === 'zh-Hans' || initialLang === 'zh-Hant' ? initialLang : 'en';
const htmlLang = documentLang === 'zh-Hans' ? 'zh-CN' : documentLang === 'zh-Hant' ? 'zh-HK' : 'en';
const ogLocale = documentLang === 'zh-Hans' ? 'zh_CN' : documentLang === 'zh-Hant' ? 'zh_HK' : 'en_US';
const ogLocaleAlternates = documentLang === 'en'
  ? ['zh_CN', 'zh_HK']
  : documentLang === 'zh-Hans'
    ? ['en_US', 'zh_HK']
    : ['en_US', 'zh_CN'];
const site = resolveSite(Astro.site);
const canonicalPathname = Astro.url.pathname === '/' || Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname.includes('.') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPathname, site).toString();
const siteRoot = new URL('/', site).toString();
const defaultImage = resolveContentAssetPath(image) || resolveContentAssetPath(profile.avatar) || profile.avatar || '';
const ogImage = defaultImage ? new URL(defaultImage, site).toString() : '';
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name.en,
  image: profile.avatar,
  email: profile.email,
  url: siteRoot,
  sameAs: getSameAsLinks()
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteRoot,
  inLanguage: ['en', 'zh-CN', 'zh-HK']
};
const extraJsonLd = (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).filter(Boolean);
const structuredData = [personJsonLd, websiteJsonLd, ...extraJsonLd];
---

<!doctype html>
<html lang={htmlLang} data-lang={documentLang} data-theme="light" data-shell-layout="desktop">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="robots" content={noIndex ? 'noindex,nofollow' : 'index,follow'} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {pageType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {pageType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {pageType === 'article' && author && <meta property="article:author" content={author} />}
    {pageType === 'article' &&
      tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml" />
    {
      structuredData.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>
      ))
    }
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src={plausibleScript}></script>}
    {umamiScript && umamiWebsiteId && <script is:inline defer src={umamiScript} data-website-id={umamiWebsiteId}></script>}
    <script is:inline>
      (() => {
        if (location.hostname !== 'mengyanggao.github.io') return;
        location.replace(`https://gaomengyang.com${location.pathname}${location.search}${location.hash}`);
      })();
    </script>
    <script is:inline>
      (() => {
        const key = 'site-theme';
        const root = document.documentElement;
        try {
          const saved = localStorage.getItem(key);
          const theme = saved === 'dark' || saved === 'light' ? saved : 'light';
          root.dataset.theme = theme;
        } catch {
          root.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <span class="lang-en">Skip to main content</span>
      <span class="lang-zh-hans">跳转到正文内容</span>
      <span class="lang-zh-hant">跳轉到正文內容</span>
    </a>
    <slot />
    <footer class="site-foot">
      <p class="site-foot-signature">
        <em>
          <LocalizedTextView text={footer.signature} />
        </em>
      </p>
      <p class="site-foot-sub site-foot-meta">
        <a href={footer.sourceCodeUrl} target="_blank" rel="noopener noreferrer">
          {footer.sourceCodeLabel.en}
        </a>
        <span class="site-foot-sep" aria-hidden="true">
          ·
        </span>
        <span>© {footer.copyrightYear}</span>
        <a href={footer.ownerUrl} target="_blank" rel="noopener noreferrer">
          {footerOwner}
        </a>
      </p>
    </footer>

    <script>
      import { initSiteShell } from '../scripts/site-shell';
      initSiteShell();
    </script>
  </body>
</html>
